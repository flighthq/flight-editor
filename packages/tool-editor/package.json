{
  "name": "@flighthq/tool-editor",
  "version": "0.1.0",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight-editor.git",
    "directory": "packages/tool-editor"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.test.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@flighthq/editor-clipboard": "*",
    "@flighthq/editor-command": "*",
    "@flighthq/editor-hierarchy": "*",
    "@flighthq/editor-node-factory": "*",
    "@flighthq/editor-selection": "*",
    "@flighthq/editor-tool": "*",
    "@flighthq/editor-viewport": "*",
    "@flighthq/node": "*",
    "@flighthq/types": "*"
  },
  "devDependencies": {
    "@flighthq/scene2d": "*",
    "typescript": "^5.9.3"
  },
  "description": "Flight editor application core — composes selection, commands, and tools into an editor state",
  "sideEffects": false
}
