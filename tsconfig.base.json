{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noEmitOnError": true,
    "paths": {
      "@flighthq/editor-command": ["./packages/editor-command/src/index.ts"],
      "@flighthq/editor-command/*": ["./packages/editor-command/src/*"],
      "@flighthq/editor-selection": ["./packages/editor-selection/src/index.ts"],
      "@flighthq/editor-selection/*": ["./packages/editor-selection/src/*"],
      "@flighthq/editor-tool": ["./packages/editor-tool/src/index.ts"],
      "@flighthq/editor-tool/*": ["./packages/editor-tool/src/*"],
      "@flighthq/editor-viewport": ["./packages/editor-viewport/src/index.ts"],
      "@flighthq/editor-viewport/*": ["./packages/editor-viewport/src/*"],
      "@flighthq/tool-editor": ["./packages/tool-editor/src/index.ts"],
      "@flighthq/tool-editor/*": ["./packages/tool-editor/src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["./packages/*/src"],
  "exclude": ["node_modules", "dist", ".claude"]
}
