{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noEmitOnError": true,
    "paths": {
      "@flighthq/editor-command": ["./packages/editor-command/src/index.ts"],
      "@flighthq/editor-command/*": ["./packages/editor-command/src/*"],
      "@flighthq/editor-node-factory": ["./packages/editor-node-factory/src/index.ts"],
      "@flighthq/editor-node-factory/*": ["./packages/editor-node-factory/src/*"],
      "@flighthq/editor-selection": ["./packages/editor-selection/src/index.ts"],
      "@flighthq/editor-selection/*": ["./packages/editor-selection/src/*"],
      "@flighthq/editor-tool": ["./packages/editor-tool/src/index.ts"],
      "@flighthq/editor-tool/*": ["./packages/editor-tool/src/*"],
      "@flighthq/editor-clipboard": ["./packages/editor-clipboard/src/index.ts"],
      "@flighthq/editor-clipboard/*": ["./packages/editor-clipboard/src/*"],
      "@flighthq/editor-hierarchy": ["./packages/editor-hierarchy/src/index.ts"],
      "@flighthq/editor-hierarchy/*": ["./packages/editor-hierarchy/src/*"],
      "@flighthq/editor-keyboard": ["./packages/editor-keyboard/src/index.ts"],
      "@flighthq/editor-keyboard/*": ["./packages/editor-keyboard/src/*"],
      "@flighthq/editor-scene-state": ["./packages/editor-scene-state/src/index.ts"],
      "@flighthq/editor-scene-state/*": ["./packages/editor-scene-state/src/*"],
      "@flighthq/editor-snap": ["./packages/editor-snap/src/index.ts"],
      "@flighthq/editor-snap/*": ["./packages/editor-snap/src/*"],
      "@flighthq/editor-viewport": ["./packages/editor-viewport/src/index.ts"],
      "@flighthq/editor-viewport/*": ["./packages/editor-viewport/src/*"],
      "@flighthq/tool-editor": ["./packages/tool-editor/src/index.ts"],
      "@flighthq/tool-editor/*": ["./packages/tool-editor/src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["./packages/*/src"],
  "exclude": ["node_modules", "dist", ".claude"]
}
