{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/src/**/*.ts", "packages/**/src/**/*.test.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", ".claude"]
}
