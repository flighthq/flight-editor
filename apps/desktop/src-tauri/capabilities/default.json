{
  "identifier": "default",
  "description": "Default capabilities for the Flight Editor desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "clipboard-manager:default",
    "clipboard-manager:allow-read",
    "clipboard-manager:allow-write"
  ]
}
