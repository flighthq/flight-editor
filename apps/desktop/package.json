{
  "name": "@flighthq/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flight Editor desktop application (Tauri)",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:frontend": "tsc -p tsconfig.json && vite build",
