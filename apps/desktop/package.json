  },
  "dependencies": {
    "@flighthq/editor-host": "0.1.0",
    "@flighthq/tool-editor": "0.1.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
